# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code — keep CLAUDE.md, .claude/agents/ and .claude/launch.json in the repo
# (the team shares those); ignore only per-machine settings and local state.
.claude/settings.local.json
.claude/*.local.md

# The prototype is deliberately buildless and offline — nothing here should ever
# need node_modules. This is only a guard against `npx serve` and friends
# leaving artefacts behind in the repo.
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*
.npm/

# Python backend
backend/.venv/
backend/.env
__pycache__/
*.pyc
.pytest_cache/

# Next.js frontend
.next/
*.tsbuildinfo
next-env.d.ts

# Scratch
*.log
tmp/
scratch/
*.original.md
